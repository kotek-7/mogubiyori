{
  "name": "mogubiyori",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "vite --mode cloudflare --host 127.0.0.1 --port 8787",
    "deploy": "pnpm run build && wrangler deploy",
    "build": "node scripts/content/validate-pack.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:cloud": "playwright test --config playwright.cloud.config.ts",
    "test:db": "bash supabase/tests/run-local.sh",
    "format": "prettier --write src shared worker tests docs *.ts *.json *.jsonc *.html *.md",
    "format:check": "prettier --check src shared worker tests docs *.ts *.json *.jsonc *.html *.md",
    "content:build": "node scripts/content/build-pack.mjs && node scripts/content/validate-pack.mjs",
    "content:check": "node scripts/content/validate-pack.mjs"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@xstate/react": "^6.1.0",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xstate": "^5.33.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.58.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "4.137.0"
  }
}
