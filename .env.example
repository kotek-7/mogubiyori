# With no Supabase settings, development uses existing browser saves.
# Setting the URL and publishable key selects cloud mode automatically.
# Cloud restores the session or creates an anonymous user without a login screen.
# Only the publishable key belongs in VITE_*; never add a service-role key here.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Enable only after configuring Google OAuth and manual identity linking in Supabase.
# Omitted or false hides Google actions; anonymous play and cloud saving remain available.
# VITE_GOOGLE_AUTH_ENABLED=true

# Optional explicit override: cloud requires both settings; local uses browser saves.
# Cloud connection errors never fall back to a local save.
# VITE_GAME_MODE=cloud
# VITE_GAME_MODE=local
