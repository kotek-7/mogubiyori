# Local play preserves existing browser saves. Cloud mode never falls back to local saves.
VITE_GAME_MODE=local
# Set all three for the cloud build. Only the publishable key belongs in VITE_*.
# VITE_GAME_MODE=cloud
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
